{
  "openapi": "3.1.0",
  "info": {
    "title": "Euphony Automation API",
    "version": "v1",
    "description": "Terminal-first automation API exposed over TCP and a local Unix socket."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/status": {
      "get": {
        "operationId": "getStatus",
        "security": [],
        "responses": {
          "200": {
            "description": "Server status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/schema": {
      "get": {
        "operationId": "getSchema",
        "security": [],
        "responses": {
          "200": {
            "description": "Raw OpenAPI 3.1 document",
            "content": {
              "application/vnd.oai.openapi+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "operationId": "subscribeEvents",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Newline-delimited state events",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/terminals": {
      "get": {
        "operationId": "listTerminals",
        "responses": {
          "200": {
            "$ref": "#/components/responses/TerminalList"
          }
        }
      },
      "post": {
        "operationId": "createTerminal",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTerminalRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/TerminalCreated"
          }
        }
      }
    },
    "/api/v1/terminals/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TerminalID"
        }
      ],
      "get": {
        "operationId": "getTerminal",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Terminal"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "deleteTerminal",
        "responses": {
          "200": {
            "$ref": "#/components/responses/TerminalDeleted"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/terminals/{id}/output": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TerminalID"
        }
      ],
      "get": {
        "operationId": "readTerminal",
        "parameters": [
          {
            "name": "maxBytes",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216,
              "default": 1048576
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/TerminalRead"
          }
        }
      }
    },
    "/api/v1/terminals/{id}/input": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TerminalID"
        }
      ],
      "post": {
        "operationId": "sendTerminalInput",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TerminalInputRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Accepted"
          }
        }
      }
    },
    "/api/v1/terminals/{id}/run": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TerminalID"
        }
      ],
      "post": {
        "operationId": "runTerminalCommand",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["command"],
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1048576
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Accepted"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/terminals/{id}/wait-output": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TerminalID"
        }
      ],
      "post": {
        "operationId": "waitForTerminalOutput",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WaitOutputRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/WaitOutput"
          },
          "408": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/terminals/{id}/tickets": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TerminalID"
        }
      ],
      "post": {
        "operationId": "createTerminalStreamTicket",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mode"],
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": ["observe", "control"]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/TerminalTicket"
          }
        }
      }
    },
    "/api/v1/terminals/{id}/stream": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TerminalID"
        },
        {
          "name": "ticket",
          "in": "query",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "streamTerminal",
        "security": [],
        "x-euphony-websocket": {
          "clientFrame": {
            "$ref": "#/components/schemas/TerminalClientFrame"
          },
          "serverFrame": {
            "$ref": "#/components/schemas/TerminalFrame"
          }
        },
        "responses": {
          "101": {
            "description": "WebSocket terminal stream"
          }
        }
      }
    },
    "/api/v1/agents": {
      "get": {
        "operationId": "listAgents",
        "responses": {
          "200": {
            "$ref": "#/components/responses/AgentList"
          }
        }
      }
    },
    "/api/v1/agents/{id}": {
      "parameters": [{"$ref": "#/components/parameters/TerminalID"}],
      "get": {
        "operationId": "getAgent",
        "responses": {
          "200": {"$ref": "#/components/responses/Agent"},
          "409": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/v1/agents/{id}/start": {
      "parameters": [{"$ref": "#/components/parameters/TerminalID"}],
      "post": {
        "operationId": "startAgent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/StartAgentRequest"}
            }
          }
        },
        "responses": {
          "200": {"$ref": "#/components/responses/Agent"},
          "408": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/v1/agents/{id}/output": {
      "parameters": [{"$ref": "#/components/parameters/TerminalID"}],
      "get": {
        "operationId": "readAgent",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["transcript", "terminal"],
              "default": "transcript"
            }
          },
          {
            "name": "maxBytes",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          }
        ],
        "responses": {
          "200": {"$ref": "#/components/responses/AgentOutput"}
        }
      }
    },
    "/api/v1/agents/{id}/input": {
      "parameters": [{"$ref": "#/components/parameters/TerminalID"}],
      "post": {
        "operationId": "sendAgentInput",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/AgentInputRequest"}
            }
          }
        },
        "responses": {
          "200": {"$ref": "#/components/responses/AgentAccepted"}
        }
      }
    },
    "/api/v1/agents/{id}/prompt": {
      "parameters": [{"$ref": "#/components/parameters/TerminalID"}],
      "post": {
        "operationId": "promptAgent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/PromptAgentRequest"}
            }
          }
        },
        "responses": {
          "200": {"$ref": "#/components/responses/AgentAccepted"},
          "408": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/v1/agents/{id}/wait": {
      "parameters": [{"$ref": "#/components/parameters/TerminalID"}],
      "post": {
        "operationId": "waitForAgent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/WaitAgentRequest"}
            }
          }
        },
        "responses": {
          "200": {"$ref": "#/components/responses/Agent"},
          "408": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/v1/selection": {
      "get": {
        "operationId": "getSelection",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Selection"
          }
        }
      },
      "put": {
        "operationId": "replaceSelection",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplaceSelectionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Selection"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/selection/actions": {
      "post": {
        "operationId": "applySelectionAction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectionAction"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Selection"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "TerminalID": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Accepted": {
        "description": "Input accepted",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/AcceptedEnvelope"}
          }
        }
      },
      "TerminalList": {
        "description": "Terminal list",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/TerminalListEnvelope"}
          }
        }
      },
      "TerminalCreated": {
        "description": "Created terminal and shared selection",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/TerminalCreatedEnvelope"}
          }
        }
      },
      "Terminal": {
        "description": "Terminal metadata",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/TerminalEnvelope"}
          }
        }
      },
      "TerminalDeleted": {
        "description": "Deleted terminal and shared selection",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/TerminalDeletedEnvelope"}
          }
        }
      },
      "TerminalRead": {
        "description": "Bounded terminal output",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/TerminalReadEnvelope"}
          }
        }
      },
      "WaitOutput": {
        "description": "Matched terminal output",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/WaitOutputEnvelope"}
          }
        }
      },
      "TerminalTicket": {
        "description": "Single-use terminal stream ticket",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/TerminalTicketEnvelope"}
          }
        }
      },
      "AgentList": {
        "description": "Active coding agents",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/AgentListEnvelope"}
          }
        }
      },
      "Agent": {
        "description": "Coding agent metadata",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/AgentEnvelope"}
          }
        }
      },
      "AgentAccepted": {
        "description": "Agent input accepted",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/AgentAcceptedEnvelope"}
          }
        }
      },
      "AgentOutput": {
        "description": "Agent transcript or terminal output",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/AgentOutputEnvelope"}
          }
        }
      },
      "Selection": {
        "description": "Shared selection snapshot",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/SelectionEnvelope"}
          }
        }
      },
      "Success": {
        "description": "Successful operation",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SuccessEnvelope"
            }
          }
        }
      },
      "Error": {
        "description": "API error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "CreateTerminalRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "default": "Terminal"
          },
          "cwd": {
            "type": "string"
          },
          "selectionMode": {
            "type": "string",
            "enum": ["none", "add", "replace"],
            "default": "none"
          }
        },
        "additionalProperties": false
      },
      "TerminalInputRequest": {
        "type": "object",
        "oneOf": [
          {"required": ["text"]},
          {"required": ["dataBase64"]},
          {"required": ["keys"]}
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "dataBase64": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9+/]*$"
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "WaitOutputRequest": {
        "type": "object",
        "properties": {
          "match": {
            "type": "string"
          },
          "regex": {
            "type": "string"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400000
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          }
        },
        "additionalProperties": false
      },
      "StartAgentRequest": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["codex", "claude"]
          },
          "args": {
            "type": "array",
            "items": {"type": "string"}
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300000
          }
        },
        "additionalProperties": false
      },
      "AgentInputRequest": {
        "type": "object",
        "required": ["keys"],
        "properties": {
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      },
      "PromptAgentRequest": {
        "type": "object",
        "required": ["prompt"],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576
          },
          "wait": {
            "type": "boolean",
            "default": false
          },
          "until": {"$ref": "#/components/schemas/AgentStates"},
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300000
          }
        },
        "additionalProperties": false
      },
      "WaitAgentRequest": {
        "type": "object",
        "properties": {
          "until": {"$ref": "#/components/schemas/AgentStates"},
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300000
          }
        },
        "additionalProperties": false
      },
      "AgentStates": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["running", "waiting", "blocked"]
        }
      },
      "ReplaceSelectionRequest": {
        "type": "object",
        "required": [
          "manualTerminalIds",
          "pinnedTerminalIds",
          "filters"
        ],
        "properties": {
          "manualTerminalIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pinnedTerminalIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "focusedTerminalId": {
            "type": "string"
          },
          "filters": {
            "$ref": "#/components/schemas/SelectionFilters"
          },
          "pinnedFilters": {
            "$ref": "#/components/schemas/SelectionFilters"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "SelectionAction": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "replace",
              "add",
              "remove",
              "focus",
              "pin",
              "unpin",
              "filter_status_set",
              "filter_status_add",
              "filter_status_remove",
              "filter_cwd_set",
              "filter_cwd_add",
              "filter_cwd_remove"
            ]
          },
          "terminalIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "focusedTerminalId": {
            "type": "string"
          },
          "statuses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TerminalStatus"
            }
          },
          "cwdFilters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CWDFilter"
            }
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "SuccessEnvelope": {
        "type": "object",
        "required": ["ok", "result"],
        "properties": {
          "ok": {
            "const": true
          },
          "result": {}
        }
      },
      "StatusEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/SuccessEnvelope"},
          {
            "type": "object",
            "properties": {
              "result": {
                "type": "object",
                "required": ["apiVersion", "status"],
                "properties": {
                  "apiVersion": {"const": "v1"},
                  "status": {"const": "ok"}
                },
                "additionalProperties": false
              }
            }
          }
        ]
      },
      "AcceptedEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/SuccessEnvelope"},
          {
            "type": "object",
            "properties": {
              "result": {
                "type": "object",
                "required": ["accepted"],
                "properties": {"accepted": {"const": true}},
                "additionalProperties": false
              }
            }
          }
        ]
      },
      "TerminalListEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/SuccessEnvelope"},
          {
            "type": "object",
            "properties": {
              "result": {
                "type": "object",
                "required": ["terminals"],
                "properties": {
                  "terminals": {
                    "type": "array",
                    "items": {"$ref": "#/components/schemas/Terminal"}
                  }
                },
                "additionalProperties": false
              }
            }
          }
        ]
      },
      "TerminalCreatedEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/SuccessEnvelope"},
          {
            "type": "object",
            "properties": {
              "result": {
                "type": "object",
                "required": ["terminal", "selection"],
                "properties": {
                  "terminal": {"$ref": "#/components/schemas/Terminal"},
                  "selection": {"$ref": "#/components/schemas/Selection"}
                },
                "additionalProperties": false
              }
            }
          }
        ]
      },
      "TerminalEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/SuccessEnvelope"},
          {
            "type": "object",
            "properties": {
              "result": {
                "type": "object",
                "required": ["terminal"],
                "properties": {
                  "terminal": {"$ref": "#/components/schemas/Terminal"}
                },
                "additionalProperties": false
              }
            }
          }
        ]
      },
      "TerminalDeletedEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/SuccessEnvelope"},
          {
            "type": "object",
            "properties": {
              "result": {
                "type": "object",
                "required": ["id", "selection"],
                "properties": {
                  "id": {"type": "string"},
                  "selection": {"$ref": "#/components/schemas/Selection"}
                },
                "additionalProperties": false
              }
            }
          }
        ]
      },
      "TerminalReadEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/SuccessEnvelope"},
          {
            "type": "object",
            "properties": {
              "result": {"$ref": "#/components/schemas/TerminalRead"}
            }
          }
        ]
      },
      "WaitOutputEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/SuccessEnvelope"},
          {
            "type": "object",
            "properties": {
              "result": {
                "type": "object",
                "required": ["terminalId", "matchedLine", "read"],
                "properties": {
                  "terminalId": {"type": "string"},
                  "matchedLine": {"type": "string"},
                  "read": {"$ref": "#/components/schemas/TerminalRead"}
                },
                "additionalProperties": false
              }
            }
          }
        ]
      },
      "TerminalTicketEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/SuccessEnvelope"},
          {
            "type": "object",
            "properties": {
              "result": {
                "type": "object",
                "required": ["ticket", "mode"],
                "properties": {
                  "ticket": {"type": "string"},
                  "mode": {"type": "string", "enum": ["observe", "control"]}
                },
                "additionalProperties": false
              }
            }
          }
        ]
      },
      "AgentListEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/SuccessEnvelope"},
          {
            "type": "object",
            "properties": {
              "result": {
                "type": "object",
                "required": ["agents"],
                "properties": {
                  "agents": {
                    "type": "array",
                    "items": {"$ref": "#/components/schemas/Terminal"}
                  }
                },
                "additionalProperties": false
              }
            }
          }
        ]
      },
      "AgentEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/SuccessEnvelope"},
          {
            "type": "object",
            "properties": {
              "result": {
                "type": "object",
                "required": ["agent"],
                "properties": {
                  "agent": {"$ref": "#/components/schemas/Terminal"}
                },
                "additionalProperties": false
              }
            }
          }
        ]
      },
      "AgentAcceptedEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/SuccessEnvelope"},
          {
            "type": "object",
            "properties": {
              "result": {
                "type": "object",
                "required": ["accepted", "agent"],
                "properties": {
                  "accepted": {"const": true},
                  "agent": {"$ref": "#/components/schemas/Terminal"}
                },
                "additionalProperties": false
              }
            }
          }
        ]
      },
      "AgentOutputEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/SuccessEnvelope"},
          {
            "type": "object",
            "properties": {
              "result": {
                "oneOf": [
                  {"$ref": "#/components/schemas/TerminalRead"},
                  {"$ref": "#/components/schemas/AgentTranscript"}
                ]
              }
            }
          }
        ]
      },
      "SelectionEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/SuccessEnvelope"},
          {
            "type": "object",
            "properties": {
              "result": {"$ref": "#/components/schemas/Selection"}
            }
          }
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["ok", "error"],
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "$ref": "#/components/schemas/APIError"
          }
        }
      },
      "APIError": {
        "type": "object",
        "required": ["code", "message", "details"],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {}
        }
      },
      "TerminalStatus": {
        "type": "string",
        "enum": ["starting", "running", "waiting", "blocked", "attention", "terminal", "exited", "failed"]
      },
      "CWDFilter": {
        "type": "object",
        "required": ["status", "cwd"],
        "properties": {
          "status": {"$ref": "#/components/schemas/TerminalStatus"},
          "cwd": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "SelectionFilters": {
        "type": "object",
        "required": ["statuses", "cwds"],
        "properties": {
          "statuses": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/TerminalStatus"}
          },
          "cwds": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/CWDFilter"}
          }
        },
        "additionalProperties": false
      },
      "TerminalRead": {
        "type": "object",
        "required": ["terminalId", "dataBase64", "text", "byteCount", "truncated"],
        "properties": {
          "terminalId": {"type": "string"},
          "dataBase64": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]*$"
          },
          "text": {"type": "string"},
          "byteCount": {"type": "integer", "minimum": 0},
          "truncated": {"type": "boolean"}
        },
        "additionalProperties": false
      },
      "AgentTranscriptEntry": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string"},
          "kind": {
            "type": "string",
            "enum": ["message", "thinking", "tool", "tool_result", "tool_group"]
          },
          "role": {"type": "string"},
          "title": {"type": "string"},
          "content": {"type": "string"},
          "toolCalls": {"type": "integer", "minimum": 1},
          "timestamp": {"type": "string"}
        },
        "additionalProperties": false
      },
      "AgentTranscript": {
        "type": "object",
        "required": ["agent", "sessionId", "entries"],
        "properties": {
          "agent": {"type": "string", "enum": ["codex", "claude"]},
          "sessionId": {"type": "string"},
          "entries": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/AgentTranscriptEntry"}
          },
          "startCursor": {"type": "string", "pattern": "^[0-9]+$"},
          "endCursor": {"type": "string", "pattern": "^[0-9]+$"},
          "nextCursor": {"type": "string", "pattern": "^[0-9]+$"}
        },
        "additionalProperties": false
      },
      "Terminal": {
        "type": "object",
        "required": ["id", "name", "state", "cwd", "createdAt"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": ["starting", "running", "exited", "failed"]
          },
          "cwd": {
            "type": "string"
          },
          "repoRoot": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "agentStatus": {
            "type": "string"
          },
          "needsAttention": {
            "type": "boolean"
          },
          "agentTitle": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Selection": {
        "type": "object",
        "required": [
          "terminalIds",
          "manualTerminalIds",
          "pinnedTerminalIds",
          "filters",
          "pinnedFilters",
          "revision"
        ],
        "properties": {
          "terminalIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "manualTerminalIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pinnedTerminalIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "focusedTerminalId": {
            "type": "string"
          },
          "filters": {
            "$ref": "#/components/schemas/SelectionFilters"
          },
          "pinnedFilters": {
            "$ref": "#/components/schemas/SelectionFilters"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Event": {
        "type": "object",
        "required": ["sequence", "occurredAt", "type", "data"],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string"
          },
          "data": {}
        }
      },
      "TerminalFrame": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["history", "history_end", "output", "exit"]
          },
          "dataBase64": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]*$"
          },
          "exitCode": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "TerminalClientFrame": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "dataBase64"],
            "properties": {
              "type": {"const": "input"},
              "dataBase64": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9+/]*$"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "cols", "rows"],
            "properties": {
              "type": {"const": "resize"},
              "cols": {"type": "integer", "minimum": 1, "maximum": 1000},
              "rows": {"type": "integer", "minimum": 1, "maximum": 1000}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "data"],
            "properties": {
              "type": {"const": "cwd"},
              "data": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
